{
  "description": "Shared evaluator test vectors. Every evaluator (Rust engine, browser UI, exported code) must reproduce these. `null` means the value is undefined under protected semantics (NaN).",
  "version": 1,
  "tolerance": 1e-12,
  "cases": [
    { "expr": "x + y", "variables": ["x", "y"], "points": [[1, 2], [-1.5, 0.25]], "expected": [3, -1.25] },
    { "expr": "x * y - x / y", "variables": ["x", "y"], "points": [[3, 2], [1, 0]], "expected": [4.5, null] },
    { "expr": "x ^ y", "variables": ["x", "y"], "points": [[2, 10], [-8, 0.5], [-2, 3]], "expected": [1024, null, -8] },
    { "expr": "log(x)", "variables": ["x"], "points": [[1], [0], [-1]], "expected": [0, null, null] },
    { "expr": "exp(x)", "variables": ["x"], "points": [[0], [1]], "expected": [1, 2.718281828459045] },
    { "expr": "sqrt(x)", "variables": ["x"], "points": [[4], [0], [-1]], "expected": [2, 0, null] },
    { "expr": "square(x) + abs(x)", "variables": ["x"], "points": [[-3], [2.5]], "expected": [12, 8.75] },
    { "expr": "inv(x)", "variables": ["x"], "points": [[4], [0], [1e-13]], "expected": [0.25, null, null] },
    { "expr": "-x ^ 2", "variables": ["x"], "points": [[3]], "expected": [-9] },
    { "expr": "(-x) ^ 2", "variables": ["x"], "points": [[3]], "expected": [9] },
    { "expr": "2.5 * capital ^ 0.7 * labor ^ 0.3", "variables": ["capital", "labor"], "points": [[1, 1], [16, 1]], "expected": [2.5, 17.411011265922482] },
    { "expr": "x / (1 + y)", "variables": ["x", "y"], "points": [[3, 2], [1, -1]], "expected": [1, null] },
    { "expr": "tanh(x) + sin(x) + cos(x)", "variables": ["x"], "points": [[0]], "expected": [1] },
    { "expr": "`Marketing Spend` * 2 - price", "variables": ["Marketing Spend", "price"], "points": [[10, 3]], "expected": [17] },
    { "expr": "10 * exp(-0.5 * x1) + log(x2)", "variables": ["x1", "x2"], "points": [[0, 1], [2, 1]], "expected": [10, 3.6787944117144233] }
  ]
}
