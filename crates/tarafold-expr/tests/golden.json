{
  "description": "Shared evaluator test vectors. Every evaluator (Rust engine, browser UI, exported code) must reproduce these. `null` means the value is undefined under protected semantics (NaN).",
  "version": 1,
  "tolerance": 1e-12,
  "cases": [
    {"expr":"x + y","variables":["x","y"],"points":[[1.0,2.0],[-1.5,0.25]],"expected":[3.0,-1.25],"tree":{"op":"add","args":[{"var":"x"},{"var":"y"}]}},
    {"expr":"x * y - x / y","variables":["x","y"],"points":[[3.0,2.0],[1.0,0.0]],"expected":[4.5,null],"tree":{"op":"sub","args":[{"op":"mul","args":[{"var":"x"},{"var":"y"}]},{"op":"div","args":[{"var":"x"},{"var":"y"}]}]}},
    {"expr":"x ^ y","variables":["x","y"],"points":[[2.0,10.0],[-8.0,0.5],[-2.0,3.0]],"expected":[1024.0,null,-8.0],"tree":{"op":"pow","args":[{"var":"x"},{"var":"y"}]}},
    {"expr":"log(x)","variables":["x"],"points":[[1.0],[0.0],[-1.0]],"expected":[0.0,null,null],"tree":{"op":"log","args":[{"var":"x"}]}},
    {"expr":"exp(x)","variables":["x"],"points":[[0.0],[1.0]],"expected":[1.0,2.718281828459045],"tree":{"op":"exp","args":[{"var":"x"}]}},
    {"expr":"sqrt(x)","variables":["x"],"points":[[4.0],[0.0],[-1.0]],"expected":[2.0,0.0,null],"tree":{"op":"sqrt","args":[{"var":"x"}]}},
    {"expr":"square(x) + abs(x)","variables":["x"],"points":[[-3.0],[2.5]],"expected":[12.0,8.75],"tree":{"op":"add","args":[{"op":"square","args":[{"var":"x"}]},{"op":"abs","args":[{"var":"x"}]}]}},
    {"expr":"inv(x)","variables":["x"],"points":[[4.0],[0.0],[1e-13]],"expected":[0.25,null,null],"tree":{"op":"inv","args":[{"var":"x"}]}},
    {"expr":"-x ^ 2","variables":["x"],"points":[[3.0]],"expected":[-9.0],"tree":{"op":"neg","args":[{"op":"pow","args":[{"var":"x"},{"const":2.0}]}]}},
    {"expr":"(-x) ^ 2","variables":["x"],"points":[[3.0]],"expected":[9.0],"tree":{"op":"pow","args":[{"op":"neg","args":[{"var":"x"}]},{"const":2.0}]}},
    {"expr":"2.5 * capital ^ 0.7 * labor ^ 0.3","variables":["capital","labor"],"points":[[1.0,1.0],[16.0,1.0]],"expected":[2.5,17.411011265922482],"tree":{"op":"mul","args":[{"op":"mul","args":[{"const":2.5},{"op":"pow","args":[{"var":"capital"},{"const":0.7}]}]},{"op":"pow","args":[{"var":"labor"},{"const":0.3}]}]}},
    {"expr":"x / (1 + y)","variables":["x","y"],"points":[[3.0,2.0],[1.0,-1.0]],"expected":[1.0,null],"tree":{"op":"div","args":[{"var":"x"},{"op":"add","args":[{"const":1.0},{"var":"y"}]}]}},
    {"expr":"tanh(x) + sin(x) + cos(x)","variables":["x"],"points":[[0.0]],"expected":[1.0],"tree":{"op":"add","args":[{"op":"add","args":[{"op":"tanh","args":[{"var":"x"}]},{"op":"sin","args":[{"var":"x"}]}]},{"op":"cos","args":[{"var":"x"}]}]}},
    {"expr":"`Marketing Spend` * 2 - price","variables":["Marketing Spend","price"],"points":[[10.0,3.0]],"expected":[17.0],"tree":{"op":"sub","args":[{"op":"mul","args":[{"var":"Marketing Spend"},{"const":2.0}]},{"var":"price"}]}},
    {"expr":"10 * exp(-0.5 * x1) + log(x2)","variables":["x1","x2"],"points":[[0.0,1.0],[2.0,1.0]],"expected":[10.0,3.6787944117144233],"tree":{"op":"add","args":[{"op":"mul","args":[{"const":10.0},{"op":"exp","args":[{"op":"mul","args":[{"const":-0.5},{"var":"x1"}]}]}]},{"op":"log","args":[{"var":"x2"}]}]}}
  ]
}
